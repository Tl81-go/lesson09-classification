def make_logistic_model(use_weights):
    return make_pipeline(
        StandardScaler(),
        LogisticRegression(
            max_iter=2000,
            random_state=42,
            class_weight="balanced" if use_weights else None,
        ),
    )


def make_tree_model(use_weights):
    return DecisionTreeClassifier(
        max_depth=3,
        min_samples_leaf=5,
        random_state=42,
        class_weight="balanced" if use_weights else None,
    )


# --------------------------------------------------
# 2차원 경계선용 데이터 생성
# --------------------------------------------------

def make_2d_grid(
    features,
    x_feature,
    y_feature,
    fixed_values,
    x_grid,
    y_grid,
):
    rows = []

    for y_value in y_grid:
        for x_value in x_grid:
            row = {}

            for feature in features:
                if feature == x_feature:
                    row[feature] = x_value
                elif feature == y_feature:
                    row[feature] = y_value
                else:
                    row[feature] = fixed_values[feature]

            rows.append(row)

    return pd.DataFrame(rows, columns=features)


# --------------------------------------------------
# 3차원 경계면용 데이터 생성
# --------------------------------------------------

def make_3d_grid(
    features,
    x_feature,
    y_feature,
    z_feature,
    fixed_values,
    x_grid,
    y_grid,
    z_grid,
):
    rows = []

    for z_value in z_grid:
        for y_value in y_grid:
            for x_value in x_grid:
                row = {}

                for feature in features:
                    if feature == x_feature:
                        row[feature] = x_value
                    elif feature == y_feature:
                        row[feature] = y_value
                    elif feature == z_feature:
                        row[feature] = z_value
                    else:
                        row[feature] = fixed_values[feature]

                rows.append(row)

    return pd.DataFrame(rows, columns=features)


