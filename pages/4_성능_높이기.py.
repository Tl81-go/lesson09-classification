# 평가 지표 계산
# --------------------------------------------------

def calculate_metrics(y_true, y_pred):
    y_true = np.asarray(y_true)
    y_pred = np.asarray(y_pred)

    tp = int(((y_true == 1) & (y_pred == 1)).sum())
    fp = int(((y_true == 0) & (y_pred == 1)).sum())
    fn = int(((y_true == 1) & (y_pred == 0)).sum())
    tn = int(((y_true == 0) & (y_pred == 0)).sum())

    total = tp + fp + fn + tn

    accuracy = (
        (tp + tn) / total
        if total > 0
        else None
    )

    recall = (
        tp / (tp + fn)
        if (tp + fn) > 0
        else None
    )

    precision = (
        tp / (tp + fp)
        if (tp + fp) > 0
        else None
    )

    if precision is None or recall is None:
        f1 = None
    elif precision + recall == 0:
        f1 = 0.0
    else:
        f1 = (
            2 * precision * recall
            / (precision + recall)
        )

    return {
        "TP": tp,
        "FP": fp,
        "FN": fn,
        "TN": tn,
        "정확도": accuracy,
        "재현율": recall,
        "정밀도": precision,
        "F1": f1,
        "전체": total,
    }


def format_metric(value):
    if value is None:
        return "계산할 수 없음"
    return f"{value:.2%}"


